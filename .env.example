NEXT_PUBLIC_API_BASE_URL=/api/agent
PIXEL_AGENT_API_BASE_URL=http://127.0.0.1:8101/api

# Auth. Without PIXEL_AUTH_SECRET every API restart invalidates existing logins.
PIXEL_AUTH_SECRET=replace_with_a_long_random_string
# Passwordless demo login (any demo identity, including admin). Only set this to true
# for an isolated deployment holding synthetic data; it is refused whenever unset.
PIXEL_SYNTHETIC_DEMO=true
# Demo identity the browser signs in as (demo-admin, demo-product-eng, demo-platform).
# Non-admin users only see and change their own workspace.
NEXT_PUBLIC_PIXEL_DEMO_USER=demo-admin

# Microsoft Azure Speech, used first for Edith's neural voice.
# Create a Speech resource in Azure, rotate any key pasted in chat, then copy the new values locally.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE_NAME=en-US-Ava:DragonHDLatestNeural
AZURE_SPEECH_OUTPUT_FORMAT=audio-48khz-192kbitrate-mono-mp3

# Optional fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=15000
LLM_MAX_CALLS_PER_SESSION=25
LLM_THINKING_LEVEL=minimal
LLM_THINKING_BUDGET=0
OPENAI_API_KEY=your_openai_api_key_here
