NEXT_PUBLIC_API_BASE_URL=/api/agent
PIXEL_AGENT_API_BASE_URL=http://127.0.0.1:8101/api

# Microsoft Azure Speech, used first for Edith's neural voice.
# Create a Speech resource in Azure, rotate any key pasted in chat, then copy the new values locally.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE_NAME=en-US-Ava:DragonHDLatestNeural
AZURE_SPEECH_OUTPUT_FORMAT=audio-48khz-192kbitrate-mono-mp3

# Optional fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
